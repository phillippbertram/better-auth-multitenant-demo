{
  "name": "better-auth-organizations-demo",
  "version": "0.1.0",
  "description": "A multi-tenant Better Auth organizations, teams, roles, invitations, passkeys, and notes demo.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "auth:generate": "auth generate --config src/lib/auth.ts --output src/db/auth-schema.ts --yes",
    "admin:create": "auth create-admin --config src/lib/auth.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@better-auth/passkey": "^1.7.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "antd": "^6.6.3",
    "better-auth": "^1.7.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "1.7.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "vitest": "^5.0.0"
  }
}
