DATABASE_URL=postgresql://postgres:postgres@localhost:5433/better_auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional: show one-click access for users created by pnpm db:seed:demo.
DEMO_MODE=false

# Safety override for intentionally seeding a non-local database.
DEMO_SEED_ALLOW_REMOTE=false

# Optional host port used by Docker Compose.
# POSTGRES_PORT=5433
